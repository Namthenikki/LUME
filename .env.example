# Copy to .env.local (and add the same values to Vercel). Everything except NEXT_PUBLIC_* is a secret:
# never commit .env.local.

# Private Brightspace calendar feed (Calendar → Subscribe → all courses). Contains a personal token.
MUJ_ICS_URL=

# Schedulers send "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=

# The password you type once per device to unlock the dashboard.
OWNER_PASSWORD=
# Signs the unlock cookie and notification buttons. Any long random string; changing it signs every device out.
AUTH_SECRET=

# Firebase service account (Project settings → Service accounts → Generate new private key).
# FIREBASE_PRIVATE_KEY keeps its newlines as \n, inside double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini reads NPTEL's deadline emails (free key: https://aistudio.google.com/apikey).
# GEMINI_MODEL is optional; set it if the default model is ever retired.
GEMINI_API_KEY=
GEMINI_MODEL=

# Firebase web app (Project settings → General → Your apps → Web app config) and the
# Web Push key (Project settings → Cloud Messaging → Web Push certificates). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
